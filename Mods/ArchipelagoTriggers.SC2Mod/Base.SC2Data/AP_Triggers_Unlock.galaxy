    RegisterZergUnit(5, "AP_UnlockAberration", UnlockEvolutionChamber);
    RegisterZergUnit(6, "AP_UnlockMutalisk", UnlockSpire);
    RegisterZergUnit(7, "AP_UnlockSwarmHost", UnlockInfestationPit);
    RegisterZergUnit(8, "AP_UnlockInfestor", UnlockInfestationPit);
    RegisterZergUnit(9, "AP_UnlockUltralisk", UnlockUltraliskDen);
    RegisterZergUnit(12, "AP_UnlockCorruptor", UnlockSpire);

    //Larva Advanced
    RegisterZergUnit(25, "AP_UnlockPygalisk", UnlockSpawningPool);
    RegisterZergUnit(13, "AP_UnlockScourge", UnlockSpire);
    RegisterZergUnit(14, "AP_UnlockBroodQueen", UnlockSpire);
    RegisterZergUnit(15, "AP_UnlockDefiler", UnlockInfestationPit);

    // Morphs
    RegisterZergUnit(29, "AP_UnlockImpaler", UnlockImpalerFunc);
    RegisterZergUnit(30, "AP_UnlockLurker", UnlockLurkerFunc);
    RegisterZergUnit(31, "AP_UnlockBroodLord", UnlockBroodLordFunc);
    RegisterZergUnit(32, "AP_UnlockViper", UnlockViperFunc);
    RegisterZergUnit(42, "AP_UnlockGuardian", UnlockGuardianFunc);
    RegisterZergUnit(43, "AP_UnlockDevourer", UnlockDevourerFunc);
    RegisterZergUnit(44, "AP_UnlockRavager", UnlockRavagerFunc);

    RegisterZergUnit(45, "AP_UnlockOverseer", null);

    // Infested
    RegisterZergUnit(16, "AP_UnlockInfestedMarine", UnlockInfestedBarracks);
    RegisterZergUnit(20, "AP_UnlockInfestedSiegeTank", UnlockInfestedFactory);
    RegisterZergUnit(21, "AP_UnlockInfestedDiamondback", UnlockInfestedFactory);
    RegisterZergUnit(22, "AP_UnlockInfestedBanshee", UnlockInfestedStarport);
    RegisterZergUnit(23, "AP_UnlockInfestedLiberator", UnlockInfestedStarport);
    RegisterZergUnit(27, "AP_UnlockBullfrog", UnlockInfestedFactory);

