static void RapidReinforcementFunc (int player) {
    int i;
    string cooldownLink;
    if (TechTreeUpgradeCount(player, "AP_RapidReinforcement", c_techCountCompleteOnly) > 0 ) {
        return;
    }
    TechTreeUpgradeAddLevel(player, "AP_RapidReinforcement", 1);
    for (i = 0; i < lib15EF4C78_gv_aP_Player_MERC_COOLDOWN_LINK_SIZE; i += 1) {
        if ( lib15EF4C78_gv_aP_Player_MercType[i] == lib15EF4C78_ge_AP_Player_MercenaryType_INFANTRY
        || lib15EF4C78_gv_aP_Player_MercType[i] == lib15EF4C78_ge_AP_Player_MercenaryType_VEHICLE
        || lib15EF4C78_gv_aP_Player_MercType[i] == lib15EF4C78_ge_AP_Player_MercenaryType_STARSHIP
        ) {
            cooldownLink = lib15EF4C78_gv_aP_Player_MercCooldownLinks[i];
            PlayerAddCooldown(player, cooldownLink, -60.0);
        }
    }
}

static void VultureMagazineFunc(int player, int level) {
    int i;
    unit u;
    unitgroup g;
    order o;
    if (TechTreeUpgradeCount(player, "AP_ReplenishSpiderMineFree", c_techCountCompleteOnly) > 0 ) {
        return;
    }
    if (level >= 1) {
        TechTreeUpgradeAddLevel(player, "AP_NanoConstructor", 1);
        if (level >= 2) {
            TechTreeUpgradeAddLevel(player, "AP_ReplenishSpiderMineFree", 1);
            g = UnitGroup("AP_Vulture", player, RegionEntireMap(), UnitFilterStandard, 0);
            o = OrderSetAutoCast(AbilityCommand("AP_MakeVultureSpiderMines", 0), true);
            UnitGroupIssueOrder(g, o, c_orderQueueAddToFront);
        }
    }
}

static void BattlecruiserShieldsFunc(int player, int level) {
    if (level >= 1) {
        TechTreeUpgradeAddLevel(player, "AP_DefensiveMatrix", 1);
        if (level >= 2) {
            TechTreeUpgradeAddLevel(player, "AP_BattlecruiserAdvancedDefensiveMatrix", 1);
            libNtve_gf_SetUpgradeLevelForPlayer(player, "AP_ShieldRegenBonusBattlecruiser", 1);
            libNtve_gf_SetUpgradeLevelForPlayer(player, "AP_ShieldRegenBonusBattlecruiser100Stack", 1);
        }
    }
}

static void PlanetaryLiftoffFunc(int player, int level) {
    if (level >= 1) {
        TechTreeUpgradeAddLevel(player, "AP_PlanetaryFortressLiftOff", 1);
        if (level >= 2) {
            TechTreeUpgradeAddLevel(player, "AP_PlanetaryFortressLevel", 1);
            if (TechTreeUpgradeCount(player, "AP_PlanetaryFortressAirAttack", c_techCountCompleteOnly) > 0) {
                TechTreeUpgradeAddLevel(player, "AP_PlanetaryFortressAirAttackFlying", 1);
            }
        }
    }
}

static void FastDeliveryFunc(int player, int level) {
    int index;
    int upgradeLevel = TechTreeUpgradeCount(player, "AP_FastDeliveryLevel1", c_techCountCompleteOnly);
    int upgradeLevel2 = TechTreeUpgradeCount(player, "AP_FastDelivery", c_techCountCompleteOnly);
    if (level >= 1 && upgradeLevel == 0) {
        TechTreeUpgradeAddLevel(player, "AP_FastDeliveryLevel1", 1);
        lib15EF4C78_gf_AP_Player_ClearMercenaryCooldownsTerran(player);
    }
    if (level >= 2 && upgradeLevel2 == 0) {
        TechTreeUpgradeAddLevel(player, "AP_FastDelivery", 1);
        lib15EF4C78_gf_AP_Player_ClearMercenaryCooldownsTerran(player);
    }
    libNtve_gf_SetUpgradeLevelForPlayer(player, "AP_FastDeliveryCharges", lib15EF4C78_gf_AP_Player_MercCompoundGetInstantUses(player));
}

static void BioSteelFunc(int player, int level) {
    if (level >= 1) {
        TechTreeUpgradeAddLevel(player, "AP_RegenerativeBioSteel", 1);
        if (level >= 2) {
            TechTreeUpgradeAddLevel(player, "AP_RegenerativeBioSteelLevel2", 1);
            if (level >= 3) {
                TechTreeUpgradeAddLevel(player, "AP_RegenerativeBioSteelLevel3", 1);
            }
        }
    }
}

static void HandleTerranUpgrade(int player, int level, int index, int modifier) {
    int i;
    if (libABFE498B_gf_AP_Triggers_isGenericUpgradeAutoUnlock()) {
        for (i = 0; i < level; i += 1) {
            TechTreeUpgradeAddLevel(player, WAUpgradeDatabase[index][i], 1);
        }
    }
    else {
        for (i = 0; i < level; i += 1) {
            TechTreeUpgradeAllow(player, WAUpgradeDatabase[index][i], true);
            TechTreeUpgradeAllow(player, WAUpgradeDatabase[index + modifier][i], true);
        }
    }
}

static void TerranInfantryWeaponFunc (int player, int level) {
    int index = 0;
    int modifier = 1;
    UnlockEngineeringBay(player);
    if (TechTreeUpgradeCount(player, "AP_UltraCapacitors", c_techCountCompleteOnly) > 0 ) {
        index += 1;
        modifier = -1;
    }
    HandleTerranUpgrade(player, level , index, modifier);
}

static void TerranInfantryArmorFunc (int player, int level) {
    int index = 2;
    int modifier = 1;
    UnlockEngineeringBay(player);
    if (TechTreeUpgradeCount(player, "AP_VanadiumPlating", c_techCountCompleteOnly) > 0 ) {
