static void UnlockHive (int player) {
    TechTreeUpgradeAddLevel(player, "AP_UnlockHive", 1);
}

static void UnlockSpawningPool (int player) {
    TechTreeUpgradeAddLevel(player, "AP_UnlockSpawningPool", 1);
}

static void UnlockEvolutionChamber (int player) {
    TechTreeUpgradeAddLevel(player, "AP_UnlockEvolutionChamber", 1);
}

static void UnlockRoachWarren (int player) {
    TechTreeUpgradeAddLevel(player, "AP_UnlockRoachWarren", 1);
}

static void UnlockBanelingNest (int player) {
    TechTreeUpgradeAddLevel(player, "AP_UnlockBanelingNest", 1);
}

static void UnlockHydraliskDen (int player) {
    TechTreeUpgradeAddLevel(player, "AP_UnlockHydraliskDen", 1);
}

static void UnlockGreaterHydraliskDen (int player) {
    UnlockHydraliskDen(player);
    TechTreeUpgradeAddLevel(player, "AP_UnlockGreaterHydraliskDen", 1);
}

static void UnlockInfestationPit (int player) {
    TechTreeUpgradeAddLevel(player, "AP_UnlockInfestationPit", 1);
}

static void UnlockSpire (int player) {
    TechTreeUpgradeAddLevel(player, "AP_UnlockSpire", 1);
}

static void UnlockGreaterSpire (int player) {
    UnlockHive(player);
    UnlockSpire(player);
    TechTreeUpgradeAddLevel(player, "AP_UnlockGreaterSpire", 1);
}

static void UnlockUltraliskDen (int player) {
    UnlockHive(player);
    TechTreeUpgradeAddLevel(player, "AP_UnlockUltraliskDen", 1);
}

static void UnlockInfestedSCV(int player) {
    TechTreeUpgradeAddLevel(player, "AP_UnlockInfestedSCV", 1);
}

static void UnlockInfestedBarracks (int player) {
    UnlockInfestedSCV(player);
    TechTreeUpgradeAddLevel(player, "AP_UnlockInfestedBarracks", 1);
}

static void UnlockInfestedFactory (int player) {
    UnlockInfestedSCV(player);
    TechTreeUpgradeAddLevel(player, "AP_UnlockInfestedFactory", 1);
}

static void UnlockInfestedStarport (int player) {
    UnlockInfestedSCV(player);
    TechTreeUpgradeAddLevel(player, "AP_UnlockInfestedStarport", 1);
}

static void UnlockNydusNetwork (int player) {
    TechTreeUpgradeAddLevel(player, "AP_UnlockNydusNetwork", 1);
}

static void UnlockMercSC2(int player) {
    TechTreeUpgradeAddLevel(player, "AP_UnlockPredatorNest", 1);
    TechTreeUpgradeAddLevel(player, "AP_ZergMercCompoundSC2" , 1);
}

static void UnlockMercBroodWar(int player) {
    TechTreeUpgradeAddLevel(player, "AP_UnlockPredatorNest", 1);
    TechTreeUpgradeAddLevel(player, "AP_ZergMercCompoundBroodWar" , 1);
}

static void UnlockMercInfested(int player) {
    TechTreeUpgradeAddLevel(player, "AP_UnlockPredatorNest", 1);
    TechTreeUpgradeAddLevel(player, "AP_ZergMercCompoundInfested" , 1);
}

static void UnlockMorphling(int player) {
    if (libABFE498B_gv_aP_Triggers_Option_enableMorphling) {
        TechTreeUpgradeAddLevel(player, "AP_UnlockMorphling", 1);
    }
}
static void UnlockTyrannozorFunc(int player) {
    UnlockUltraliskDen(player);
    UnlockMorphling(player);
}

static void UnlockPrimalIgniterFunc(int player) {
    UnlockRoachWarren(player);
    UnlockMorphling(player);
}

static void UnlockImpalerFunc(int player) {
    TechTreeUpgradeAddLevel(player, "", 1);
    UnlockGreaterHydraliskDen(player);
    UnlockMorphling(player);
}

static void UnlockFunc(int player) {
    TechTreeUpgradeAddLevel(player, "", 1);
    Unlock(player);
    UnlockMorphling(player);
}


