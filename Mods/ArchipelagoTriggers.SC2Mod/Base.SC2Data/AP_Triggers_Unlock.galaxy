static void LiberatorCloakFunc (int player) {
    int i;
    unit u;
    unitgroup g;
    fixed startingEnergy = 50;
    if (TechTreeUpgradeCount(player, "AP_CloakingTechnologyLiberator", c_techCountCompleteOnly) > 0 ) {
        return;
    }
    // add upgrade here to ensure starting energy is added properly
    TechTreeUpgradeAddLevel(player, "AP_CloakingTechnologyLiberator", 1);
    if (TechTreeUpgradeCount(player, "AP_CellularReactors", c_techCountCompleteOnly) > 0) {
        TechTreeUpgradeAddLevel(player, "AP_CellularReactorsLiberator", 1);
        startingEnergy = 150;
    }
    g = UnitGroup("AP_Liberator", player, RegionEntireMap(), UnitFilterStandard, 0);
    UnitGroupAddUnitGroup(g, UnitGroup("AP_LiberatorAG", player, RegionEntireMap(), UnitFilterStandard, 0));
    for (i = 1; i <= UnitGroupCount(g, c_unitCountAll); i += 1) {
        u = UnitGroupUnit(g, i);
        UnitSetPropertyFixed(u, c_unitPropEnergy, startingEnergy);
    }
}

static void BunkerFortifiedShrikeFunc (int player) {
    if (TechTreeUpgradeCount(player, "AP_ShrikeTurret", c_techCountCompleteOnly) > 0
    || TechTreeUpgradeCount(player, "AP_FortifiedBunkerCarapace", c_techCountCompleteOnly) > 0
    ) {
        TechTreeUpgradeAddLevel(player, "AP_NeoSteelAndShrikeTurretIconUpgrade", 1);
    }
}

