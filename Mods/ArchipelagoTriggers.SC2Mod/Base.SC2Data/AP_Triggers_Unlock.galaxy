static void ZerglingStrainFunc (int player) {
    if (TechTreeUpgradeCount(player, "AP_HotSHaveRaptor", c_techCountCompleteOnly) >= 1
    && TechTreeUpgradeCount(player, "AP_HotSHaveSwarmling", c_techCountCompleteOnly) >= 1)
    {
        TechTreeUpgradeAddLevel(player, "AP_HotSHaveRaptorSwarmling", 1);
    }
}

static void RoachStrainFunc (int player) {
    if (TechTreeUpgradeCount(player, "AP_RoachVile", c_techCountCompleteOnly) >= 1
    && TechTreeUpgradeCount(player, "AP_RoachCorpser", c_techCountCompleteOnly) >= 1)
    {
        TechTreeUpgradeAddLevel(player, "AP_RoachVileCorpser", 1);
    }
}

static void RoachTunnelSpeedFunc (int player) {
    if (TechTreeUpgradeCount(player, "AP_HotSTunnelingClaws", c_techCountCompleteOnly) >= 1
    && TechTreeUpgradeCount(player, "AP_HotSRoachSpeed", c_techCountCompleteOnly) >= 1)
    {
        TechTreeUpgradeAddLevel(player, "AP_GlialReconstitutionTunnelingClaws", 1);
    }
}

static void BanelingStrainFunc (int player) {
    if (TechTreeUpgradeCount(player, "AP_HotSSplitter", c_techCountCompleteOnly) >= 1
    && TechTreeUpgradeCount(player, "AP_HotSHunter", c_techCountCompleteOnly) >= 1)
    {
        TechTreeUpgradeAddLevel(player, "AP_HotSHunterSplitter", 1);
    }
}

static void SwarmHostStrainFunc (int player) {
    if (TechTreeUpgradeCount(player, "AP_HotSHaveSwarmHostSplitA", c_techCountCompleteOnly) >= 1
    && TechTreeUpgradeCount(player, "AP_HotSHaveSwarmHostSplitB", c_techCountCompleteOnly) >= 1)
    {
        TechTreeUpgradeAddLevel(player, "AP_HotSHaveSwarmHostSplitAB", 1);
    }
}

static void UltraliskStrainFunc (int player) {
    if (TechTreeUpgradeCount(player, "AP_HotSNoxious", c_techCountCompleteOnly) >= 1
    && TechTreeUpgradeCount(player, "AP_HotSTorrasque", c_techCountCompleteOnly) >= 1)
    {
        TechTreeUpgradeAddLevel(player, "AP_HotSNoxiousTorrasque", 1);
    }
}

static void EvolutionaryLeapFunc (int player) {
    int i;
    fixed cooldown;
    string field;
    if (TechTreeUpgradeCount(player,"AP_EvolutionaryLeapLevel1",c_techCountCompleteOnly) > 0) {
        return;
    }
    TechTreeUpgradeAddLevel(player,"AP_EvolutionaryLeapLevel1",1);
    for (i = 0; i < lib15EF4C78_gv_aP_Player_MERC_COOLDOWN_LINK_SIZE; i += 1) {
        if ( lib15EF4C78_gv_aP_Player_MercType[i] == lib15EF4C78_ge_AP_Player_MercenaryType_BROODWAR
        || lib15EF4C78_gv_aP_Player_MercType[i] == lib15EF4C78_ge_AP_Player_MercenaryType_INFESTED
        || lib15EF4C78_gv_aP_Player_MercType[i] == lib15EF4C78_ge_AP_Player_MercenaryType_SCTWO
        ) {
            field = "InfoArray[" + IntToString(lib15EF4C78_gv_aP_Player_MercAbilityInfoArrayIndex[i]) + "].Cooldown.TimeStart";
            cooldown = libNtve_gf_CatalogFieldValueGetAsReal(c_gameCatalogAbil, lib15EF4C78_gv_aP_Player_MercAbility[i], field, player);
            PlayerAddCooldown(player, lib15EF4C78_gv_aP_Player_MercCooldownLinks[i], 0.0 - cooldown);
        }
    }
}

static void MalignantCreepFunc(int player) {
    int i;
    unit u;
    unitgroup g;
    if (TechTreeUpgradeCount(player, "AP_K5CreepBonuses", c_techCountQueuedOrBetter) > 0) {
        return;
    }
    TechTreeUpgradeAddLevel(player, "AP_K5CreepBonuses", 1);
    g = UnitGroup(null, player, RegionEntireMap(), UnitFilterStandard, 0);
    for (i = 1; i <= UnitGroupCount(g, c_unitCountAll); i += 1) {
        u = UnitGroupUnit(g, i);
        lib15EF4C78_gf_AP_Player_applyMalignantCreepFix(u);
    }
}

static void HandleZergUpgrade(int player, int level, int index) {
    int i;
    if (libABFE498B_gf_AP_Triggers_isGenericUpgradeAutoUnlock()) {
        for (i = 0; i < level; i += 1) {
            TechTreeUpgradeAddLevel(player, WAUpgradeDatabase[index + 12][i], 1);
        }
    }
    else {
        for (i = 0; i < level; i += 1) {
            TechTreeUpgradeAllow(player, WAUpgradeDatabase[index + 12][i], true);
        }
    }
}

static void ZergMeleeWeaponFunc (int player, int level) {
    UnlockEvolutionChamber(player);
    HandleZergUpgrade(player, level, 0);
}

static void ZergMissileWeaponFunc (int player, int level) {
    UnlockEvolutionChamber(player);
    HandleZergUpgrade(player, level, 1);
}

static void ZergCarapaceFunc (int player, int level) {
    UnlockEvolutionChamber(player);
    HandleZergUpgrade(player, level, 2);
}

static void ZergFlyerWeaponFunc (int player, int level) {
    UnlockSpire(player);
    HandleZergUpgrade(player, level, 3);
}

static void ZergFlyerArmorFunc (int player, int level) {
    UnlockSpire(player);
    HandleZergUpgrade(player, level, 4);
}

