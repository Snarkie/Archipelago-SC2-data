    // Hatchery
    RegisterZergUnit(1, "AP_UnlockSwarmQueen", UnlockSpawningPool);
    RegisterZergUnit(28, "AP_UnlockHiveQueen", null);

    // Larva Basic
    RegisterZergUnit(0, "AP_UnlockZergling", UnlockSpawningPool);
